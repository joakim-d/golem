# Driver step 3: the wave channel. The first trigger loads a wave; the same wave is never
# reloaded (same instrument, another instrument with the same wave, or across the loop); a
# different wave is. Covers the four NR32 volume codes, length enable and C without a note.
ticks_per_row 04

wave_instrument 1 00 20     # 100%, wave 0
wave_instrument 2 00 40     # 50%, wave 0
wave_instrument 3 C0 E1     # length C0 enabled, 25%, wave 1
wave_instrument 4 10 02     # muted (volume code 0), wave 2
wave 0 0123456789ABCDEFFEDCBA9876543210
wave 1 FFFFFFFFFFFFFFFF0000000000000000
wave 2 02468ACEFFFFFFFFECA8642000000000

order 00 00 01 00
order 00 00 02 00

pattern 00

pattern 01                  # order 0
00 C-4 1 ...                # loads wave 0
04 E-4 . ...                # same instrument: no reload
08 G-4 2 ...                # other instrument, same wave: no reload
0C --- . C30                # NR32 = 25%
10 C-5 3 ...                # loads wave 1
18 --- . C10                # NR32 = 100%
20 A-3 4 ...                # loads wave 2
28 C-3 1 ...                # loads wave 0

pattern 02                  # order 1
00 D-4 . ...                # wave 0 still loaded
10 F-4 3 ...                # loads wave 1
1C --- . C00                # NR32 = mute
30 C-3 1 ...                # loads wave 0, so the loop to order 0 does not reload
