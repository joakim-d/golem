# Vibrato (4): a centred square wave. On non-row tick t, the channel's period + y for
# t = 1..x, - y for the next x ticks, and so on (x = 0 counts as 1), clamped to the note
# table; it moves the pitch, not the period, and the next row tick restores the period.
# Channels 1-3; ignored on channel 4.
ticks_per_row 06

pulse 1 00 80 F3
pulse 2 80 40 A7            # length enabled
wave_instrument 1 00 A0     # length enabled, 100%, wave 0
noise 1 00 F1
wave 0 0123456789ABCDEFFEDCBA9876543210

order 01 02 03 04

pattern 01                  # channel 1
00 C-4 2 412                # + 2, - 2, + 2, - 2, + 2
01 --- . 422                # restore, then + 2 for 2 ticks, - 2 for 2 ticks, + 2
02 --- . 402                # x = 0 counts as 1
03 --- . 410                # y = 0: nothing
04 B-7 . 41F                # + 15 clamps to B-7 (no change), - 15 below it
05 C-2 . 41F                # + 15 above it, - 15 clamps to C-2
06 E-4 . 104                # portamento: the period moves to E-4 + 20
07 --- . 414                # vibrato around the slid period
08 --- . C80                # restore first, then C's retrigger at the period

pattern 02                  # channel 2
00 --- . 412                # no note yet: nothing
02 G-4 1 413                # on the same ticks as channel 1

pattern 03                  # channel 3
00 C-4 1 412                # wave channel: NR33/NR34

pattern 04                  # channel 4
00 C-4 1 412                # ignored on noise
