# Tone portamento (3): a note on a 3 row does not trigger (except the channel's first note):
# it becomes the channel's note and the target its period slides toward, xx per non-row
# tick, without passing it. 3 without a note keeps sliding to the target; 300 or no target
# does nothing; a new note clears the target. Channels 1-3; on noise the note triggers.
ticks_per_row 04

pulse 1 00 80 F3
pulse 2 80 40 A7            # length enabled
wave_instrument 1 00 A0     # length enabled, 100%, wave 0
noise 1 00 F1
wave 0 0123456789ABCDEFFEDCBA9876543210

order 01 02 03 04

pattern 01                  # channel 1
00 C-4 2 340                # first note: an ordinary trigger
04 E-4 . 340                # up to E-4, then stops
08 C-4 . 380                # down to C-4, then stops
0C G-4 . 308                # slow: G-4 is not reached in this row
0D --- . 308                # keeps sliding toward G-4
0E --- . 0C0                # arpeggio from G-4 (the new note); base step at the slid period
10 --- . 300                # 00: nothing
14 B-4 . ...                # a new note clears the target
15 --- . 310                # no target: nothing

pattern 02                  # channel 2
04 G-4 1 ...
08 C-5 . 320                # slides on the same ticks as channel 1

pattern 03                  # channel 3
00 C-4 1 ...
04 G-4 . 360                # wave channel: NR33/NR34

pattern 04                  # channel 4
00 C-4 1 ...
04 E-4 . 340                # noise: the note triggers, nothing slides
